        "사막"
      ],
      "weight": 1
    },
    {
      "id": "w096",
      "stage": "stage_3",
      "type": "sentence",
      "text": "보물은 우리가 되찾은 글자였어.",
      "difficulty": 3,
      "tags": [
        "사막"
      ],
      "weight": 1
    },
    {
      "id": "w097",
      "stage": "stage_3",
      "type": "sentence",
      "text": "지도 뒷면에 새 길이 나타났어.",
      "difficulty": 3,
      "tags": [
        "사막"
      ],
      "weight": 1
    },
    {
      "id": "w098",
      "stage": "stage_4",
      "type": "sentence",
      "text": "기관실! 앞에 끊어진 선로가 보여요.",
